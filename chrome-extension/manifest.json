{
  "manifest_version": 3,
  "name": "Focus Favorite - Social Media Saved Content Collector",
  "version": "1.1.0",
  "description": "Automatically extract and sync your saved posts from TikTok, YouTube Shorts, and Facebook.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://www.facebook.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Favorite Ingest"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
